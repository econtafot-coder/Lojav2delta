-- Montar lista
---------------------------------------------------------------------
local function limpar()
    for _, c in ipairs(lista:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
end

local function atualizar()
    limpar()
    local achados = achar()
    status.Text = (#achados > 0) and ("Encontrado: " .. #achados) or "Nao encontrado (chegue perto/Atualizar)"
    for idx, p in ipairs(achados) do
        local linha = Instance.new("Frame")
        linha.Size = UDim2.new(1, 0, 0, 26)
        linha.BackgroundTransparency = 1
        linha.LayoutOrder = idx
        linha.Parent = lista

        local nome = (p.ObjectText ~= "" and p.ObjectText) or p.Parent.Name
        local abrirBtn = Instance.new("TextButton")
        abrirBtn.Size = UDim2.new(1, -52, 1, 0)
        abrirBtn.BackgroundColor3 = Color3.fromRGB(40, 110, 70)
        abrirBtn.BorderSizePixel = 0
        abrirBtn.Text = "Abrir " .. nome
        abrirBtn.TextColor3 = Color3.new(1, 1, 1)
        abrirBtn.Font = Enum.Font.GothamBold
        abrirBtn.TextSize = 11
        abrirBtn.TextTruncate = Enum.TextTruncate.AtEnd
        abrirBtn.Parent = linha
        Instance.new("UICorner", abrirBtn).CornerRadius = UDim.new(0, 6)
        abrirBtn.MouseButton1Click:Connect(function() abrir(p) end)

        local irBtn = Instance.new("TextButton")
        irBtn.Size = UDim2.new(0, 46, 1, 0)
        irBtn.Position = UDim2.new(1, -46, 0, 0)
        irBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
        irBtn.BorderSizePixel = 0
        irBtn.Text = "Ir"
        irBtn.TextColor3 = Color3.new(1, 1, 1)
        irBtn.Font = Enum.Font.GothamBold
        irBtn.TextSize = 11
        irBtn.Parent = linha
        Instance.new("UICorner", irBtn).CornerRadius = UDim.new(0, 6)
        irBtn.MouseButton1Click:Connect(function() irAte(p) end)
    end
end

btnAtualizar.MouseButton1Click:Connect(atualizar)

