-- Loja GUI | Delta Executor (versao rapida)
-- Detecta ProximityPrompts com nome "Loja de armas" e abre pelo botao do GUI.
-- Para outro alvo, mude a linha ALVO abaixo.

local ALVO = "loja de armas"   -- texto procurado (minusculo)

-- Ajustes de velocidade (segundos)
local ESPERA_CHEGAR = 0.06   -- tempo no prompt antes de acionar (menor = mais rapido; se falhar, suba p/ 0.1)
local TEMPO_MAXIMO  = 0.8    -- limite de espera pela GUI do jogo abrir
local VOLTAR        = true   -- volta pro lugar original depois de abrir

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local lp = Players.LocalPlayer

-- Remove GUI antigo se executar de novo
local function getParentGui()
    local ok, gui = pcall(function() return (gethui and gethui()) or game:GetService("CoreGui") end)
    if ok and gui then return gui end
    return lp:WaitForChild("PlayerGui")
end

local parentGui = getParentGui()
local old = parentGui:FindFirstChild("LojaGuiDelta")
if old then old:Destroy() end

---------------------------------------------------------------------
-- Deteccao dos ProximityPrompts
---------------------------------------------------------------------
local function contem(txt)
    return type(txt) == "string" and txt:lower():find(ALVO, 1, true) ~= nil
end

local function combina(p)
    if contem(p.Name) or contem(p.ObjectText) or contem(p.ActionText) then return true end
    local par = p.Parent
    for _ = 1, 3 do
        if not par then break end
        if contem(par.Name) then return true end
        par = par.Parent
    end
    return false
end

local function achar()
    local lista = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") and combina(d) then
            table.insert(lista, d)
        end
    end
    return lista
end

local function posicaoDe(p)
    local par = p.Parent
    if par and par:IsA("Attachment") then return par.WorldPosition end
    if par and par:IsA("BasePart") then return par.Position end
    if par and par:IsA("Model") then return par:GetPivot().Position end
    return nil
end

---------------------------------------------------------------------
-- Deteccao da GUI do jogo abrindo
---------------------------------------------------------------------
local function guisAtivas()
    local set = {}
    local pg = lp:FindFirstChild("PlayerGui")
    if pg then
        for _, g in ipairs(pg:GetChildren()) do
            if g:IsA("ScreenGui") and g.Enabled then set[g] = true end
        end
    end
    return set
end

local function guiNovaAbriu(antes)
    local pg = lp:FindFirstChild("PlayerGui")
    if not pg then return false end
    for _, g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled and not antes[g] and g.Name ~= "LojaGuiDelta" then
            return true
        end
    end
    return false
end

---------------------------------------------------------------------
-- Abrir (teleporte rapido + prompt volta ao normal)
---------------------------------------------------------------------
local abrindo = false

local function abrir(p)
    if abrindo then return end
    abrindo = true

    -- guarda os valores originais do prompt pra restaurar depois
    local orig = {
        Enabled = p.Enabled,
        HoldDuration = p.HoldDuration,
        RequiresLineOfSight = p.RequiresLineOfSight,
        MaxActivationDistance = p.MaxActivationDistance,
    }

    local function restaurar()
        pcall(function()
            p.MaxActivationDistance = orig.MaxActivationDistance
            p.HoldDuration = orig.HoldDuration
            p.RequiresLineOfSight = orig.RequiresLineOfSight
            p.Enabled = orig.Enabled
        end)
    end

    pcall(function()
        p.Enabled = true
        p.HoldDuration = 0
        p.RequiresLineOfSight = false
        p.MaxActivationDistance = 50   -- suficiente depois do teleporte (antes era 9e9 = prompt gigante)
    end)

    local pos = posicaoDe(p)
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local voltarCF = hrp and hrp.CFrame
    local antes = guisAtivas()

    -- teleporta direto pro prompt
    if pos and hrp then
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
        task.wait(ESPERA_CHEGAR)
    end

    -- aciona o prompt a cada frame ate a GUI do jogo abrir (ou estourar o tempo)
    local inicio = os.clock()
    local usouFire = false
    while os.clock() - inicio < TEMPO_MAXIMO do
        if fireproximityprompt then
            usouFire = pcall(fireproximityprompt, p) or usouFire
        else
            pcall(function()
                p:InputHoldBegin()
                p:InputHoldEnd()
            end)
        end
        RunService.Heartbeat:Wait()
        if guiNovaAbriu(antes) then break end
        -- se a GUI nao for um ScreenGui novo, 2 acionamentos ja bastam
        if os.clock() - inicio > 0.25 and usouFire then break end
    end

    -- prompt volta ao tamanho/alcance normal na hora
    restaurar()

    -- volta pro lugar original
    if VOLTAR and voltarCF and hrp and hrp.Parent then
        task.wait(0.05)
        hrp.CFrame = voltarCF
    end
    abrindo = false
end

local function irAte(p)
    local pos = posicaoDe(p)
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if pos and hrp then
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    end
end

